<Window x:Class="SnipNation.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipNation" Width="385" Height="245" Left="0" Top="0"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource BrandFont}" FontSize="13" Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True" PreviewKeyDown="GalleryKeyDown">
    <Border Background="{StaticResource PaneBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,9">
                <Button DockPanel.Dock="Right" Content="×" FontSize="18" Width="30" Height="30"
                        Padding="0" ToolTip="Close" AutomationProperties.Name="Close gallery" Click="CloseClicked" />
                <Button HorizontalAlignment="Left" Height="32" Padding="10,4" Content="Screenshot"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource PaneBrush}"
                        BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" Click="ScreenshotClicked" />
            </DockPanel>
            <ListBox x:Name="PreviewList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Padding="0" AutomationProperties.Name="Recent screenshots"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="PreviewDoubleClick" PreviewMouseRightButtonDown="PreviewRightClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="3" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="104" Height="68" Background="{StaticResource PaneBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" CornerRadius="4" ToolTip="{Binding Label}">
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="3"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit" Click="EditClicked" />
                        <MenuItem Header="Copy" Click="CopyClicked" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <TextBlock Grid.Row="1" Text="No screenshots yet" VerticalAlignment="Center"
                       HorizontalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedInkBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=PreviewList}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="3,5,3,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedInkBrush}" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Border>
</Window>
