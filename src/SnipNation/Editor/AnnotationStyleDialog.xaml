<Window x:Class="SnipNation.Editor.AnnotationStyleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:SnipNation.Editor"
        Title="Annotation settings" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="{StaticResource BrandFont}" FontSize="13"
        Background="{StaticResource PaneBrush}" Foreground="{StaticResource InkBrush}"
        Icon="/SnipNation;component/Assets/SnipNation.ico">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Width" Value="105" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="FieldRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{StaticResource PaneBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Box" Width="21" Height="21" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource DividerBrush}" Margin="0,0,9,0">
                                    <Path x:Name="Tick" Width="13" Height="13" Stretch="Uniform"
                                          Data="{editor:SvgIcon apply}" Stroke="{StaticResource PaneBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource EditorIconButton}" />
    </Window.Resources>
    <StackPanel Margin="16" KeyboardNavigation.TabNavigation="Cycle">
        <Border Margin="0,0,0,12" Padding="4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="5">
            <Image x:Name="PreviewImage" Height="64" Stretch="Uniform" AutomationProperties.Name="Style preview" />
        </Border>
        <DockPanel Style="{StaticResource FieldRow}">
            <Label Content="Color" Target="{Binding ElementName=ColorBox}" />
            <ComboBox x:Name="ColorBox" SelectionChanged="StyleChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" VerticalAlignment="Center" CornerRadius="2" Margin="0,0,8,0"
                                    Background="{Binding Swatch}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>
        <DockPanel x:Name="SizeRow" Style="{StaticResource FieldRow}">
            <Label x:Name="SizeLabel" Content="Width" Target="{Binding ElementName=SizeBox}" />
            <ComboBox x:Name="SizeBox" SelectionChanged="StyleChanged" />
        </DockPanel>
        <DockPanel x:Name="ArrowShapeRow" Style="{StaticResource FieldRow}">
            <Label Content="Arrow shape" Target="{Binding ElementName=ArrowShapeBox}" />
            <ComboBox x:Name="ArrowShapeBox" SelectionChanged="StyleChanged" />
        </DockPanel>
        <DockPanel x:Name="FrameShapeRow" Style="{StaticResource FieldRow}">
            <Label Content="Frame shape" Target="{Binding ElementName=FrameShapeBox}" />
            <ComboBox x:Name="FrameShapeBox" SelectionChanged="StyleChanged" />
        </DockPanel>
        <DockPanel x:Name="PatternRow" Style="{StaticResource FieldRow}">
            <Label Content="Pattern" Target="{Binding ElementName=PatternBox}" />
            <ComboBox x:Name="PatternBox" SelectionChanged="StyleChanged" />
        </DockPanel>
        <DockPanel x:Name="OpacityRow" Style="{StaticResource FieldRow}">
            <Label Content="Opacity" Target="{Binding ElementName=OpacityBox}" />
            <ComboBox x:Name="OpacityBox" SelectionChanged="StyleChanged" />
        </DockPanel>
        <DockPanel x:Name="FontRow" Style="{StaticResource FieldRow}">
            <Label Content="Font" Target="{Binding ElementName=FontBox}" />
            <ComboBox x:Name="FontBox" SelectionChanged="StyleChanged" />
        </DockPanel>
        <DockPanel x:Name="NumberShapeRow" Style="{StaticResource FieldRow}">
            <Label Content="Marker shape" Target="{Binding ElementName=NumberShapeBox}" />
            <ComboBox x:Name="NumberShapeBox" SelectionChanged="StyleChanged" />
        </DockPanel>
        <DockPanel x:Name="ConnectorRow" Style="{StaticResource FieldRow}">
            <Label Content="Connector" Target="{Binding ElementName=ConnectorBox}" />
            <ComboBox x:Name="ConnectorBox" SelectionChanged="StyleChanged" />
        </DockPanel>
        <DockPanel x:Name="NumberRow" Style="{StaticResource FieldRow}">
            <Label Content="Number" Target="{Binding ElementName=NumberBox}" />
            <TextBox x:Name="NumberBox" MinHeight="30" VerticalContentAlignment="Center" TextChanged="StyleChanged" />
        </DockPanel>
        <TextBlock x:Name="NumberError" Text="Enter a whole number greater than zero." Visibility="Collapsed"
                   Foreground="{StaticResource AccentBrush}" AutomationProperties.LiveSetting="Polite" />
        <CheckBox x:Name="BoldBox" Content="Bold text" Checked="StyleChanged" Unchecked="StyleChanged" />
        <CheckBox x:Name="OutlineBox" Content="Text outline" Checked="StyleChanged" Unchecked="StyleChanged" />
        <CheckBox x:Name="DefaultBox" Content="Save as default for this preset" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{editor:SvgIcon apply}" ToolTip="Apply style" IsDefault="True" Click="ApplyClicked" />
            <Button Content="{editor:SvgIcon cancel}" ToolTip="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
